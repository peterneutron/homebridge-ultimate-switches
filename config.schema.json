{
  "pluginAlias": "UltimateSwitches",
  "pluginType": "platform",
  "customUi": true,
  "singular": true,
  "strictValidation": true,
  "headerDisplay": "Unified automation switches and triggers for Homebridge (HB1/HB2).",
  "footerDisplay": "Phase 2 draft schema: includes core v1 features and context sensor.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "minLength": 1,
        "default": "Ultimate Switches"
      },
      "debug": {
        "title": "Debug Logging",
        "type": "boolean",
        "default": false
      },
      "commandSwitches": {
        "title": "Command Switches",
        "type": "array",
        "items": {
          "title": "Command Switch",
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "minLength": 1
            },
            "onCommand": {
              "title": "On Command",
              "type": "string",
              "minLength": 1
            },
            "offCommand": {
              "title": "Off Command",
              "type": "string"
            },
            "stateCommand": {
              "title": "State Command",
              "type": "string"
            },
            "polling": {
              "title": "Enable Polling",
              "type": "boolean",
              "default": false
            },
            "pollIntervalSeconds": {
              "title": "Poll Interval (seconds)",
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 300
            },
            "commandTimeoutSeconds": {
              "title": "Command Timeout (seconds)",
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 120
            },
            "autoOffSeconds": {
              "title": "Auto-Off (seconds)",
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        },
        "default": []
      },
      "switches": {
        "title": "Basic Switches",
        "type": "array",
        "items": {
          "title": "Basic Switch",
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "minLength": 1
            },
            "defaultOn": {
              "title": "Default On",
              "type": "boolean",
              "default": false
            },
            "persistState": {
              "title": "Persist State",
              "type": "boolean",
              "default": false
            }
          }
        },
        "default": []
      },
      "timers": {
        "title": "Timer / Momentary Switches",
        "type": "array",
        "items": {
          "title": "Timer Switch",
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "minLength": 1
            },
            "periodSeconds": {
              "title": "Period (seconds)",
              "type": "integer",
              "default": 60,
              "minimum": 1,
              "maximum": 86400
            },
            "autoOff": {
              "title": "Auto Off",
              "type": "boolean",
              "default": true
            },
            "emitMotionPulse": {
              "title": "Emit Motion Pulse",
              "type": "boolean",
              "default": true
            },
            "persistState": {
              "title": "Persist State",
              "type": "boolean",
              "default": false
            }
          }
        },
        "default": []
      },
      "locks": {
        "title": "Virtual Locks",
        "type": "array",
        "items": {
          "title": "Lock",
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "minLength": 1
            },
            "defaultState": {
              "title": "Default State",
              "type": "string",
              "default": "unlocked",
              "enum": ["locked", "unlocked"]
            },
            "persistState": {
              "title": "Persist State",
              "type": "boolean",
              "default": false
            }
          }
        },
        "default": []
      },
      "securitySystems": {
        "title": "Virtual Security Systems",
        "type": "array",
        "items": {
          "title": "Security System",
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "minLength": 1
            },
            "defaultState": {
              "title": "Default State",
              "type": "string",
              "default": "unarmed",
              "enum": ["unarmed", "armed-stay", "armed-away", "armed-night"]
            },
            "zones": {
              "title": "Zones",
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": ["Alarm"]
            },
            "armAwayButtonLabel": {
              "title": "Arm Away Button Label",
              "type": "string"
            },
            "armStayButtonLabel": {
              "title": "Arm Stay Button Label",
              "type": "string"
            },
            "armNightButtonLabel": {
              "title": "Arm Night Button Label",
              "type": "string"
            },
            "persistState": {
              "title": "Persist State",
              "type": "boolean",
              "default": true
            }
          }
        },
        "default": []
      },
      "calendarTriggers": {
        "title": "Calendar Triggers",
        "type": "array",
        "items": {
          "title": "Calendar",
          "type": "object",
          "properties": {
            "name": {
              "title": "Calendar Name",
              "type": "string",
              "minLength": 1
            },
            "url": {
              "title": "Calendar URL",
              "type": "string",
              "minLength": 1
            },
            "updateIntervalMinutes": {
              "title": "Update Interval (minutes)",
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 1440
            },
            "requestTimeoutSeconds": {
              "title": "Request Timeout (seconds)",
              "type": "integer",
              "default": 15,
              "minimum": 1,
              "maximum": 120
            },
            "updateButton": {
              "title": "Show Update Button",
              "type": "boolean",
              "default": true
            },
            "triggerOnUpdates": {
              "title": "Trigger on Updates",
              "type": "boolean",
              "default": true
            },
            "triggerOnAnyEvent": {
              "title": "Trigger on Any Event",
              "description": "When enabled, root calendar trigger follows any active calendar event. When disabled, at least one watched event pattern is required.",
              "type": "boolean",
              "default": false
            },
            "events": {
              "title": "Watched Events",
              "description": "Regex event patterns to watch. Required when Trigger on Any Event is disabled.",
              "type": "array",
              "items": {
                "title": "Event",
                "type": "object",
                "properties": {
                  "name": {
                    "title": "Event Name Pattern",
                    "type": "string",
                    "minLength": 1
                  },
                  "triggerOnUpdates": {
                    "title": "Trigger on Progress Updates",
                    "type": "boolean",
                    "default": true
                  },
                  "notifications": {
                    "title": "Notifications",
                    "type": "array",
                    "items": {
                      "title": "Notification",
                      "type": "object",
                      "properties": {
                        "name": {
                          "title": "Notification Name",
                          "type": "string",
                          "minLength": 1
                        },
                        "startOffsetMinutes": {
                          "title": "Start Offset (minutes)",
                          "type": "integer"
                        },
                        "endOffsetMinutes": {
                          "title": "End Offset (minutes)",
                          "type": "integer"
                        }
                      }
                    },
                    "default": []
                  }
                }
              },
              "default": []
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "triggerOnAnyEvent": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "events": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "default": []
      },
      "contextSensor": {
        "title": "Context Sensor",
        "type": "object",
        "required": ["enabled", "name"],
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "required": ["latitude"]
            }
          }
        ],
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean",
            "default": false
          },
          "name": {
            "title": "Accessory Name",
            "type": "string",
            "minLength": 1,
            "default": "Home Context"
          },
          "latitude": {
            "title": "Latitude",
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "title": "Longitude",
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "refreshIntervalSeconds": {
            "title": "Refresh Interval (seconds)",
            "type": "integer",
            "default": 60,
            "minimum": 30,
            "maximum": 3600
          }
        },
        "default": {
          "enabled": false,
          "name": "Home Context"
        }
      }
    }
  }
}
